<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- ======================================================================
       SIAnalyzer.Web - the hosted, executive-grade SecurityInsight Analyzer (SIA).
       ASP.NET Core, reusing the proven CEH stack patterns. Surfaces:
         * the EXEC management view (default landing) - board-ready, plain-language,
           chart-led, mobile + print friendly, NO KQL/jargon;
         * the ANALYST view (prompt box + guarded KQL + drill-down);
         * the MCP server endpoint (read-only, guardrailed tools).
       Data plane: Azure Monitor Query SDK with Managed Identity (Log Analytics
       Reader), READ-ONLY. AI: Azure OpenAI SDK, grounded, fail-soft. Auth: Entra /
       Easy Auth in the hosted internal env.
       ====================================================================== -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SIAnalyzer.Web</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Read-only Log Analytics data plane via the app's Managed Identity. -->
    <PackageReference Include="Azure.Monitor.Query" Version="1.5.0" />
    <PackageReference Include="Azure.Identity" Version="1.12.0" />
    <!-- Grounded AI narrative. Azure OpenAI via the modern OpenAI SDK surface. -->
    <PackageReference Include="Azure.AI.OpenAI" Version="2.0.0" />
    <!-- The DURABLE governance register (audit #7): Azure Table Storage via Managed Identity.
         SIA's ONLY write target, and it is SIA's OWN table - never a security platform. -->
    <PackageReference Include="Azure.Data.Tables" Version="12.9.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The governance table MAPPING (audit #7) stays internal - it is not API surface - but the
         offline tests round-trip it, because a silent mapping bug would lose exactly the fields
         a register of record exists to keep. -->
    <InternalsVisibleTo Include="SIAnalyzer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SIAnalyzer.Core\SIAnalyzer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ship the demo/seed snapshot into the publish output so the offline
         fallback + a no-config first boot can render. This seed (the sole
         surviving file under analyzer/) is now SIA-owned (the PowerShell POC
         that originally shared it is retired). -->
    <None Include="..\..\..\analyzer\seed\demo-snapshot.json">
      <Link>App_Data\demo-snapshot.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
