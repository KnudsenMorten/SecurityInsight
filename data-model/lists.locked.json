{
  "$comment": "SecurityInsight lists used by risk factors and rules (template kind: list). A \"conditions\" list holds entries that each carry a condition group; in_list is true when any entry matches. A \"values\" list holds plain values (contains_any). Customer overrides: lists.custom.json, per list id (an entry list replaces the shipped one; use \"add\" to extend it).",
  "kind": "list",
  "version": "1.0.0",
  "lists": [
    {
      "id": "unsupported_os",
      "type": "conditions",
      "description": "Operating systems out of vendor security support. Update as vendors end support.",
      "entries": [
        {
          "name": "Windows 7",
          "when": {
            "all": [
              {
                "field": "si_os_name",
                "op": "matches",
                "value": "(?i)^Windows7"
              }
            ]
          }
        },
        {
          "name": "Windows 8",
          "when": {
            "all": [
              {
                "field": "si_os_name",
                "op": "matches",
                "value": "(?i)^Windows8($|\\.)"
              }
            ]
          }
        },
        {
          "name": "Windows 8.1",
          "when": {
            "all": [
              {
                "field": "si_os_name",
                "op": "matches",
                "value": "(?i)^Windows8\\.1"
