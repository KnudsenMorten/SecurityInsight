    {
      "id": "tag_keys_environment",
      "type": "values",
      "description": "Tag keys that name the ENVIRONMENT of an Azure resource (-> si_environment). Compared without case, spaces, dashes and underscores; the first key in the list that the resource carries wins -- its own tags first, then its resource group's and subscription's. Add your own tag keys here.",
      "values": [
        "environment",
        "env",
        "stage"
      ]
    },
    {
      "id": "tag_keys_cost_center",
      "type": "values",
      "description": "Tag keys that name the COST CENTER of an Azure resource (-> si_cost_center). Same rules as tag_keys_environment.",
      "values": [
        "costcenter",
        "cost-center",
        "cost_center",
        "cost center",
        "costcentre"
      ]
    },
    {
      "id": "tag_keys_app_name",
      "type": "values",
      "description": "Tag keys that name the APPLICATION or workload an Azure resource belongs to (-> si_app_name). Same rules as tag_keys_environment.",
      "values": [
        "application",
        "applicationname",
        "application-name",
        "app",
        "appname",
        "app-name",
        "workload",
        "service",
        "system"
      ]
    },
    {
