        "Mail.ReadWrite",
        "Mail.Send",
        "Mail.ReadBasic",
        "Mail.ReadBasic.All",
        "Mail-Advanced.ReadWrite.All",
        "MailboxSettings.ReadWrite",
        "MailboxItem.Read.All",
        "MailboxItem.ImportExport.All",
        "MailboxFolder.Read.All",
