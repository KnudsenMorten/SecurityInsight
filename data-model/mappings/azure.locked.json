{
  "$comment": "Field mapping for provider 'azure': SI field <- provider source path(s) + normalisation. Template kind: field-mapping. Source paths are dot paths into the provider object the collector builds (objects below); [*] walks an array; several sources = the first non-empty one unless combine says otherwise. Customer overrides: mappings/azure.custom.json, per (field, recordTypes).",
  "kind": "field-mapping",
  "provider": "azure",
  "version": "1.0.0",
  "description": "Azure Resource Graph: resources of the in-scope types (collection-scope template), verbatim ARG rows.",
  "objects": [
    {
      "recordType": "azure_resource",
      "class": "cloud_resource",
      "parts": {
        "resource": "Azure Resource Graph: resources | where type in (scope)",
        "derived": "computed when the record is assembled (engine/data-model/SI-RecordDerived.ps1) from the resource part: isPubliclyExposed (publicNetworkAccess Enabled, blob public access, a network ACL that allows by default, a public IP with an address), inboundRdpFromInternet / inboundSshFromInternet (an NSG's own rules); managementGroupPath from the mg part the Azure discovery writes (resourcecontainers); childResources and one list per child type (si_vm_extensions, si_disks, ...) from the children part",
        "children": "the Azure child resources that roll up into this resource (collection-scope azureResourceTypes rollUpInto): id, type, name and the shape the child type names -- written by the record capture, never a record of their own",
        "mg": "the subscription's name, tenant (id + name) and management group (id + name, the chain as names and as ids) -- written by the Azure discovery from the subscription list (resourcecontainers); the derived part turns it into the name fields",
        "backup": "Azure Backup: protected, last status and time, vault (id + name), policy (id + name) -- recoveryservicesresources, the newest item per resource (engine/asset-profiling/discovery/Get-SIAzureContext.ps1)",
        "access": "who holds Owner / Contributor / User Access Administrator / Role Based Access Control Administrator directly at the resource or its resource group: principal id + name + type, role id + name -- authorizationresources",
        "policy": "Azure Policy: how many definitions the resource does not comply with and up to three of them (id + name) -- policyresources, summarised in the query",
        "change": "the resource's last change of the last 14 days: when, by whom (id + name), how, and the number of changes -- resourcechanges",
        "patch": "a machine's newest update assessment: pending critical / security updates, reboot pending -- patchassessmentresources",
        "defender": "the Defender for Cloud plan covering the resource type in its subscription (plan, tier, sub-plan) and the subscription's posture tier -- securityresources pricings",
        "diag": "diagnostic settings (enabled, each setting's destinations) -- one Azure Resource Manager read per resource, tier 0 and tier 1 resources only"
      },
      "key": "resource.id",
      "timestamp": "$collection_time",
      "gone": "the resource returns 404"
    },
    {
      "recordType": "public_ip",
      "class": "public_ip",
      "parts": {
        "resource": "Azure Resource Graph: microsoft.network/publicipaddresses",
        "mg": "as on azure_resource",
        "attached": "the resource the address is attached to (id, name, type) -- from its IP configuration and the capture's child map (a network interface -> its virtual machine)",
        "access": "as on azure_resource",
        "policy": "as on azure_resource",
        "change": "as on azure_resource",
        "defender": "as on azure_resource",
        "diag": "as on azure_resource"
      },
      "key": "resource.id",
      "timestamp": "$collection_time",
      "gone": "the resource returns 404"
    }
  ],
