    },
    {
      "field": "si_is_customer_facing",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.isCustomerFacing"
      ],
      "normalize": [
        "bool"
      ]
    },
    {
      "field": "si_internet_exposed",
      "recordTypes": [
        "device",
        "azure_resource",
        "public_ip"
      ],
      "sources": [
        "node.NodeProperties.rawData.exposedToInternet.type",
        "node.NodeProperties.rawData.hasInternetExposureSignal"
