{
  "$comment": "Field mapping for provider 'eg': SI field <- provider source path(s) + normalisation. Template kind: field-mapping. Source paths are dot paths into the provider object the collector builds (objects below); [*] walks an array; several sources = the first non-empty one unless combine says otherwise. Customer overrides: mappings/eg.custom.json, per (field, recordTypes).",
  "kind": "field-mapping",
  "provider": "eg",
  "version": "1.1.0",
  "description": "Exposure Graph (advanced hunting ExposureGraphNodes): one record per node; the node's EntityIds carry the other providers' ids. Identity nodes follow the v2.2 rule, extended for on-prem AD (operator 2026-10-09): a node with an Entra object id is a record that enriches its Entra object; a node with no Entra id but an on-prem AD identity (a domain SID, an AD account name, AD critical groups or an admin count) is kept as an AD identity record linked by SID; any other node is dropped. SIEntityIds holds the ids the identity fetch resolved.",
  "objects": [
    {
      "recordType": "device",
      "class": "device",
      "match": {
        "nodeLabels": [
          "device",
          "computer-account"
        ]
      },
      "parts": {
        "node": "ExposureGraphNodes row: NodeId, NodeLabel, NodeName, Categories, NodeProperties.rawData.*, EntityIds"
      },
      "key": "node.NodeId",
      "timestamp": "node.NodeProperties.rawData.lastSeen"
    },
    {
      "recordType": "user",
      "class": "identity",
      "match": {
        "nodeLabels": [
          "user",
          "group"
        ]
      },
      "parts": {
        "node": "ExposureGraphNodes row"
      },
      "key": "node.NodeId",
      "timestamp": "node.NodeProperties.rawData.lastSeen"
    },
    {
      "recordType": "service_principal",
      "class": "identity",
      "match": {
        "nodeLabels": [
          "serviceprincipal",
          "managedidentity"
        ]
      },
      "parts": {
        "node": "ExposureGraphNodes row"
      },
      "key": "node.NodeId",
      "timestamp": "node.NodeProperties.rawData.lastSeen"
    },
    {
      "recordType": "azure_resource",
      "class": "cloud_resource",
      "match": {
        "nodeLabelPrefix": "microsoft.",
        "exceptLabels": [
          "microsoft.network/publicipaddresses"
        ]
      },
      "parts": {
        "node": "ExposureGraphNodes row"
      },
      "key": "node.NodeId",
      "timestamp": "node.NodeProperties.rawData.lastSeen"
    },
    {
      "recordType": "public_ip",
      "class": "public_ip",
      "match": {
        "nodeLabels": [
          "microsoft.network/publicipaddresses",
          "ip"
        ]
      },
      "parts": {
        "node": "ExposureGraphNodes row"
      },
      "key": "node.NodeId",
      "timestamp": "node.NodeProperties.rawData.lastSeen"
    },
    {
      "recordType": "finding",
      "class": "finding",
      "parts": {
        "node": "ExposureGraphNodes | where NodeLabel startswith cve -- the vulnerability node (NodeName = the CVE, NodeProperties.rawData.*)"
      },
      "key": "node.NodeName",
      "timestamp": "$collection_time",
      "note": "#560 the generic SI finding fields of an Exposure Graph vulnerability node. The rawData paths Device_Missing_CVEs_* reads are in the repo; the CPE / product paths are to be confirmed (verify)."
    }
  ],
  "mappings": [
    {
      "field": "eg_node_id",
      "recordTypes": [
        "device",
        "user",
        "service_principal",
        "azure_resource",
        "public_ip"
      ],
      "sources": [
        "node.NodeId"
      ],
      "normalize": [
        "lower"
      ]
    },
    {
      "field": "si_asset_name",
      "recordTypes": [
        "device",
        "user",
        "azure_resource",
        "public_ip"
      ],
      "sources": [
        "node.NodeName"
      ],
      "normalize": [
        "trim"
      ]
    },
    {
      "field": "si_asset_name",
      "recordTypes": [
        "service_principal"
      ],
      "sources": [
        "node.NodeProperties.rawData.accountDisplayName",
        "node.NodeName"
      ],
      "normalize": [
        "trim"
      ],
      "note": "#690 (16) a service principal or managed identity node's NodeName is its object id; its name is rawData.accountDisplayName (the object id only when the graph gives no name)."
    },
    {
      "field": "mde_device_id",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.EntityIds"
      ],
      "normalize": [
        "select:type=SenseDeviceId|DeviceInventoryId:id",
        "first",
        "lower"
      ]
    },
    {
      "field": "entra_device_id",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.EntityIds"
      ],
      "normalize": [
        "select:type=AadDeviceId:id",
        "lower"
      ]
    },
    {
      "field": "azure_resource_id",
      "recordTypes": [
        "device",
        "azure_resource",
        "public_ip"
      ],
      "sources": [
        "node.EntityIds"
      ],
      "normalize": [
        "select:type=AzureResourceId:id",
        "lower"
      ]
    },
    {
      "field": "entra_object_id",
      "recordTypes": [
        "user",
        "service_principal"
      ],
      "sources": [
        "node.SIEntityIds",
        "node.EntityIds"
      ],
      "normalize": [
        "select:type=AadObjectId:id",
        "lower"
      ]
    },
    {
      "field": "ad_sid",
      "recordTypes": [
        "device",
        "user"
      ],
      "sources": [
        "node.SIEntityIds",
        "node.EntityIds",
        "node.NodeProperties.rawData.machineSid"
      ],
      "normalize": [
        "select:type=SecurityIdentifier:id",
        "upper"
      ]
    },
    {
      "field": "ad_object_guid",
      "recordTypes": [
        "device",
        "user"
      ],
      "sources": [
        "node.SIEntityIds",
        "node.EntityIds"
      ],
      "normalize": [
        "select:type=ActiveDirectoryObjectGuid:id",
        "lower"
      ]
    },
    {
      "field": "si_os_name",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.osPlatform",
        "node.NodeProperties.rawData.osDistribution"
      ],
      "normalize": [
        "trim"
      ]
    },
    {
      "field": "si_os_platform",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.osPlatform"
      ],
      "normalize": [
        "enum:os_family"
      ]
    },
    {
      "field": "si_os_version",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.osVersion"
      ],
      "normalize": [
        "trim"
      ]
    },
    {
      "field": "si_asset_type",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.deviceType"
      ],
      "normalize": [
        "enum:device_type"
