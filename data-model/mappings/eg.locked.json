    },
    {
      "field": "si_internet_exposure_cidrs",
      "recordTypes": [
        "device",
        "azure_resource"
      ],
      "sources": [
        "node.NodeProperties.rawData.exposedToInternet.effectiveRules[*].sourceCidr"
      ],
      "normalize": [
        "cidr"
      ],
      "combine": "union"
    },
    {
      "field": "si_ms_criticality",
      "recordTypes": [
        "device",
        "user",
        "service_principal",
