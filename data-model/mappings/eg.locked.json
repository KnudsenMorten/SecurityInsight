    },
    {
      "field": "si_asset_type",
      "recordTypes": [
        "user"
      ],
      "sources": [
        "node.NodeLabel"
      ],
      "normalize": [
        "enum:identity_type_eg"
      ],
      "note": "An identity only the graph knows (a group; a user or application the directory read did not return) still says what it is; the classification rows turn it into the asset type."
    },
    {
      "field": "si_asset_type",
      "recordTypes": [
        "service_principal"
      ],
      "sources": [
