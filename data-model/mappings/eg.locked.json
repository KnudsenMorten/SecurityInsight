    },
    {
      "field": "si_azure_resource_type",
      "recordTypes": [
        "azure_resource"
      ],
      "sources": [
        "node.NodeLabel"
      ],
      "normalize": [
        "lower",
        "require_contains:/",
        "regex_extract:(microsoft\\.[a-z0-9]+/[a-z0-9/]+)"
      ],
      "verify": true
    },
    {
      "field": "si_device_category",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.deviceCategory"
      ],
      "normalize": [
        "enum:device_category"
      ]
    },
    {
      "field": "si_device_subtype",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.deviceSubtype"
      ],
      "normalize": [
        "trim"
      ]
    },
    {
      "field": "si_device_roles",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.deviceRole[*]"
      ],
      "normalize": [
        "enum:eg_device_roles"
      ],
      "combine": "union"
    },
    {
      "field": "si_device_roles",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.isDomainController"
      ],
      "normalize": [
        "if_true:domain_controller"
      ],
      "combine": "union"
    },
    {
      "field": "si_device_roles",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.isExchangeServerDnsName",
        "node.NodeProperties.rawData.isTaggedAsExchangeServer"
      ],
      "normalize": [
        "if_true:exchange"
      ],
      "combine": "union"
    },
    {
      "field": "si_device_roles",
      "recordTypes": [
        "device"
      ],
      "sources": [
        "node.NodeProperties.rawData.isAdfsServer"
      ],
      "normalize": [
        "if_true:adfs"
      ],
      "combine": "union"
    },
    {
      "field": "si_join_type",
