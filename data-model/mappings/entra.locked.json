{
  "$comment": "Field mapping for provider 'entra': SI field <- provider source path(s) + normalisation. Template kind: field-mapping. Source paths are dot paths into the provider object the collector builds (objects below); [*] walks an array; several sources = the first non-empty one unless combine says otherwise. Customer overrides: mappings/entra.custom.json, per (field, recordTypes).",
  "kind": "field-mapping",
  "provider": "entra",
  "version": "1.0.0",
  "description": "Entra ID (Microsoft Graph): users, service principals and devices, with the collector's role, permission and registration look-ups attached.",
  "objects": [
    {
      "recordType": "user",
      "class": "identity",
      "parts": {
        "user": "GET /users (security $select)",
        "registration": "GET /reports/authenticationMethods/userRegistrationDetails (bulk)",
        "authenticationMethods": "GET /users/{id}/authentication/methods (Graph $batch, the users the profile keeps; written only when the user's list was read in full): readComplete, methodTypes, passwordlessOnly (absent = unknown)",
        "roles": "roleAssignments + roleEligibilitySchedules for the user (collector)",
        "memberOf": "GET /users/{id}/transitiveMemberOf (collector)",
        "azureRoles": "Azure RBAC role assignments of the principal (Azure Resource Graph authorizationresources, collector)",
        "derived": "computed when the record is assembled (engine/data-model/SI-RecordDerived.ps1): mfaStrength (the strongest MFA method registered), ownerNames (a guest's sponsors)",
        "manager": "GET /users?$expand=manager (one read for the tenant; discovery/Get-SIEntraContext.ps1): id, userPrincipalName, displayName",
        "sponsors": "GET /users?$filter=userType eq 'Guest'&$expand=sponsors: items { id, upn, name, type }",
        "ca": "Conditional Access for the user, from GET /identity/conditionalAccess/policies (enabled policies only): policyCount, mfaEnforced, mfaPolicies, excluded { id, name }, excludedFromAll (every policy that would apply excludes the user)",
        "breakGlass": "the break-glass extension attribute the customer defines (data-model list break_glass_attribute), when the user carries it: attribute, value, match (attribute=value)",
        "risk": "Identity Protection: riskyUsers (riskLevel, riskState, riskDetail, riskLastUpdatedDateTime) and the risk detections of 30 days summarised (detections30d, detectionTypes30d)",
        "roleScopes": "every role assignment with its scope (items), the paths a role is held through (paths), what activating an eligible role requires (activation), the level inside Tier 0 for an identity that holds a Tier 0 role (tierLevel: tier, level 1 tenant-wide or 2 scoped only, text, scoped)",
        "controls": "the privileged objects the identity owns: items { kind, id, name, roles }",
        "accessReview": "the last access review of the roles and groups it holds: items, lastReviewed",
        "notLicensed": "the context the tenant is not licensed for: items { fields, licence, text }",
        "profile": "the identity profiler's computed values for the object (Add-SIRecordPartsFromProfileRows): role and permission look-ups, privilege tiers, break-glass, credential expiry, owner count (#505)"
      },
      "key": "user.id",
      "timestamp": "$collection_time",
      "gone": "user.deletedDateTime is set"
    },
    {
      "recordType": "service_principal",
      "class": "identity",
      "parts": {
        "sp": "GET /servicePrincipals",
        "app": "GET /applications (one read for the tenant, owners expanded; discovery/Get-SIEntraContext.ps1): credentials, requestedPermissions (id and name), owners, publisherDomain, notes, federatedIdentityCredentials + hasFederatedCredential (a second read)",
        "owners": "GET /servicePrincipals?$expand=owners: count, items { id, upn, name, type }",
        "credUsage": "GET beta/reports/appCredentialSignInActivities: items { keyId, lastUsed }",
        "spExtra": "a managed identity's alternativeNames (its Azure resource)",
        "contextReads": "which tenant-wide reads completed: applications, federatedCredentials, delegatedGrants, credentialUse",
        "risk": "Identity Protection riskyServicePrincipals: riskLevel, riskState, riskDetail, riskLastUpdatedDateTime",
        "roleScopes": "every role assignment with its scope (items), the paths a role is held through (paths), what activating an eligible role requires (activation), the level inside Tier 0 for an identity that holds a Tier 0 role (tierLevel: tier, level 1 tenant-wide or 2 scoped only, text, scoped)",
        "controls": "the privileged objects the identity owns: items { kind, id, name, roles }",
        "accessReview": "the last access review of the application and of the roles and groups it holds: items, lastReviewed",
        "notLicensed": "the context the tenant is not licensed for: items { fields, licence, text }",
        "roles": "role assignments for the service principal (collector)",
        "azureRoles": "Azure RBAC role assignments of the principal (collector)",
        "appRoleAssignments": "GET /servicePrincipals/{id}/appRoleAssignments",
        "oauth2Grants": "GET /oauth2PermissionGrants (one read for the tenant, summarised per client): permissions, consentType, consentedUserCount, grants { resourceId, resourceName, consentType, permissions, userCount }",
        "signIn": "GET beta/reports/servicePrincipalSignInActivities (by application id): lastSignInActivity, delegatedClientSignInActivity, applicationAuthenticationClientSignInActivity ... each { lastSignInDateTime }",
        "derived": "computed when the record is assembled (engine/data-model/SI-RecordDerived.ps1): credentialExpiryDays (min over the key / password credentials of sp and app, negative = expired), ownerCount (the owners part the owners read writes; unknown when not read), isThirdPartyMultiTenant (appOwnerOrganizationId <> this tenant)",
        "profile": "the identity profiler's computed values for the object (Add-SIRecordPartsFromProfileRows): role and permission look-ups, privilege tiers, break-glass, credential expiry, owner count (#505)"
      },
      "key": "sp.id",
      "timestamp": "$collection_time"
    },
    {
      "recordType": "device",
      "class": "device",
      "parts": {
        "device": "GET /devices",
        "registeredOwners": "GET /devices?$expand=registeredOwners (one read for the tenant): items { id, upn, name, type }"
      },
      "key": "device.deviceId",
      "timestamp": "device.approximateLastSignInDateTime"
    }
  ],
