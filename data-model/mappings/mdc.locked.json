    {
      "field": "si_source_first_seen",
      "recordTypes": [
        "assessment"
      ],
      "sources": [
        "assessment.properties.status.firstEvaluationDate"
      ],
      "normalize": [
        "datetime_utc"
      ],
      "verify": true,
      "note": "#636: the one source first-seen field of a finding (the protection score's age); the same date as si_source_first_detected."
    }
  ]
}
