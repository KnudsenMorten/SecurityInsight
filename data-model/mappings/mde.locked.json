{
  "$comment": "Field mapping for provider 'mde': SI field <- provider source path(s) + normalisation. Template kind: field-mapping. Source paths are dot paths into the provider object the collector builds (objects below); [*] walks an array; several sources = the first non-empty one unless combine says otherwise. Customer overrides: mappings/mde.custom.json, per (field, recordTypes).",
  "kind": "field-mapping",
  "provider": "mde",
  "version": "1.0.0",
  "description": "Defender for Endpoint: the machines API joined with the latest DeviceInfo row (advanced hunting) per device.",
  "objects": [
    {
      "recordType": "device",
      "class": "device",
      "parts": {
        "machine": "GET api.securitycenter.microsoft.com/api/machines",
        "deviceInfo": "advanced hunting: DeviceInfo | summarize arg_max(Timestamp, *) by DeviceId (only the columns that have a value; InternetFacing = the InternetFacing* properties of AdditionalFields)",
        "defender": "advanced hunting, one query per batch of devices (Get-SIDefenderDeviceContext): Hardening (DeviceTvmInfoGathering AdditionalFields), BiosVersion / Cpu / HardwareModel (DeviceTvmHardwareFirmware), Networks / OnPublicNetwork / DefaultGateways / AdapterAddresses (DeviceNetworkInfo, 7 days), Alerts30d / HighAlerts30d / LastAlert* (AlertEvidence + AlertInfo, 30 days), LastAdminLogon / AdminLogons30d / AdminLogonAccounts (DeviceLogonEvents, 30 days), NotLicensed",
        "openAlerts": "Microsoft Graph security alerts, ONE tenant-wide paged read per run of the alerts whose status is new or in progress (Get-SIDefenderOpenAlerts, SecurityAlert.Read.All), summarised per device by the Defender device id of the alert's device evidence: Open (how many; 0 when the read was whole and none names the device), HighestSeverity, and the newest one's Title / Id / Time. No part when the read was refused or did not complete (unknown, never 0)",
        "software": "DeviceTvmSoftwareInventory: vendor/product per device (the rule index)",
        "logon": "the endpoint profiler's logon correlation: MostFrequentUserTier",
        "egQueryRules": "ids of the detection rules whose Exposure Graph query matched",
        "vulnerabilities": "advanced hunting, one query per batch of devices (Get-SIDefenderFindingSummary), SUMMARISED per device: Total (distinct CVEs), Critical / High / Medium / Low, Exploitable, HighestCvss, Software (affected products), NewestPublished / OldestPublished, Top (id = the CVE, name = the software, severity, cvss, exploit, published, fix), TopText; Status when the tenant has no such data",
        "configurations": "the same query, SUMMARISED per device: Assessed, NonCompliant, HighestImpact, AssessedAt, Categories, Top (id = the configuration id, name, category, impact), TopText; Status when the tenant has no such data",
        "findingLicence": "NotLicensed: the licence the two summaries need, when the tenant has no such data at all",
        "softwareInventory": "advanced hunting, one query per batch of devices (Get-SIDefenderFindingSummary, Add-SIDefenderSoftwareInventoryParts): DeviceTvmSoftwareInventory SUMMARISED per device -- Installed (distinct products), Products (vendor/product, every one), EndOfSupport (how many past or near their end of support) and EndOfSupportItems (\"vendor/product version (status, date)\"); always read, whether or not a rule needs the software list"
      },
      "key": "machine.id",
      "timestamp": "machine.lastSeen",
      "gone": "machine.onboardingStatus == Offboarded"
    },
    {
      "recordType": "vulnerability",
      "class": "finding",
      "parts": {
        "vuln": "advanced hunting: DeviceTvmSoftwareVulnerabilities -- one row per device x software x CVE (DeviceId, SoftwareVendor, SoftwareName, SoftwareVersion, CveId, VulnerabilitySeverityLevel, RecommendedSecurityUpdate, RecommendedSecurityUpdateId)",
        "kb": "advanced hunting: DeviceTvmSoftwareVulnerabilitiesKB -- the CVE (CvssScore, IsExploitAvailable, PublishedDate, LastModifiedTime, VulnerabilityDescription)",
        "export": "Defender API: GET /api/machines/SoftwareVulnerabilitiesExport (Vulnerability.Read.All) -- the software vulnerabilities export files (GZIP, one JSON object per line): deviceId, cveId, firstSeenTimestamp, lastSeenTimestamp, ... -- read once per Risk Analysis run, only the first sighting per device + CVE is kept"
      },
      "key": "vuln.CveId",
      "timestamp": "$collection_time",
      "note": "#560 the generic SI finding fields of a Defender vulnerability (Device_Missing_CVEs_* reads the same tables). verify = true: the path is to be confirmed on live rows. NO RECORD IS WRITTEN PER CVE ROW: the device record carries the summary (part vulnerabilities, summarised per device -- owner 2026-10-11); these rows say what each finding field reads in the Risk Analysis reports."
    },
    {
      "recordType": "configuration",
      "class": "finding",
      "parts": {
        "assessment": "advanced hunting: DeviceTvmSecureConfigurationAssessment -- one row per device x configuration (DeviceId, ConfigurationId, ConfigurationImpact, IsCompliant, IsApplicable)",
        "kb": "advanced hunting: DeviceTvmSecureConfigurationAssessmentKB (ConfigurationName, ConfigurationCategory, ConfigurationSubcategory, ConfigurationImpact, RiskDescription, ConfigurationDescription, RemediationOptions, ConfigurationBenchmarks, Tags, RelatedMitreTactics, RelatedMitreTechniques)"
      },
      "key": "assessment.ConfigurationId",
      "timestamp": "$collection_time",
      "note": "#560 the generic SI finding fields of a Defender security configuration (Device_Recommendations_* reads the same tables). NO RECORD IS WRITTEN PER SETTING ROW: the device record carries the summary (part configurations, summarised per device -- owner 2026-10-11); these rows say what each finding field reads in the Risk Analysis reports."
    }
  ],
