{
  "$comment": "Field mapping for provider 'servicenow': SI field <- provider source path(s) + normalisation. Template kind: field-mapping. Source paths are dot paths into the provider object the collector builds (objects below); [*] walks an array; several sources = the first non-empty one unless combine says otherwise. Customer overrides: mappings/servicenow.custom.json, per (field, recordTypes).",
  "kind": "field-mapping",
  "provider": "servicenow",
  "version": "1.0.0",
  "description": "ServiceNow CMDB (Table API, cmdb_ci and subclasses). Read-only inbound; the outbound hand-off is an output map.",
  "objects": [
    {
      "recordType": "cmdb_ci",
      "class": "*",
      "parts": {
        "ci": "GET /api/now/table/cmdb_ci (sysparm_fields per the scope)"
      },
      "key": "ci.sys_id",
      "timestamp": "ci.sys_updated_on"
    },
    {
      "recordType": "vulnerable_item",
      "class": "finding",
      "parts": {
        "item": "Table API sn_vul_vulnerable_item (sysparm_display_value=all): number, state, assigned_to, due_date, vulnerability, risk_score, cmdb_ci"
      },
      "key": "item.sys_id",
      "timestamp": "item.sys_updated_on",
      "note": "#560 what the customer's ITSM says about a finding SecurityInsight handed over (ticket state, assignee, due date). Every path is to be confirmed on the customer's instance (verify)."
    }
  ],
  "mappings": [
    {
      "field": "servicenow_sys_id",
      "recordTypes": [
        "cmdb_ci"
      ],
      "sources": [
        "ci.sys_id"
      ],
