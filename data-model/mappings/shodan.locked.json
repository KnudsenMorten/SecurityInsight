      ]
    },
    {
      "field": "si_tls_self_signed",
      "recordTypes": [
        "public_ip"
      ],
      "sources": [
        "derived.tlsSelfSigned"
      ],
      "normalize": [
        "bool"
      ]
    },
    {
      "field": "si_tls_earliest_expiry",
      "recordTypes": [
        "public_ip"
      ],
      "sources": [
        "derived.tlsEarliestExpiry"
      ],
      "normalize": [
