{
  "$comment": "Output map: which columns an output receives, read from the CI document. Template kind: output-map. \"from\" is an SI field, a linked-object path, or a system token ($run_id, $run_time, $row_hash, $changed_at, $const:<value>). \"op\" is from the closed output operation set. Customer overrides: outputs/<id>.custom.json (add, remove or rename columns; a column keeps its place unless moved).",
  "kind": "output-map",
  "id": "excel-findings-summary",
  "version": "1.0.0",
  "description": "Default columns of a Summary sheet: one row per finding x tier x severity x CMDB group.",
  "grain": "finding_summary",
  "columns": [
    {
      "target": "SecurityDomain",
      "from": "si_security_domain"
    },
    {
      "target": "ReportName",
      "from": "si_report_name"
    },
    {
      "target": "ConfigurationId",
      "from": "si_finding_key"
    },
    {
      "target": "ConfigurationName",
      "from": "si_title"
    },
    {
      "target": "CriticalityTier",
      "from": "si_tier"
    },
    {
      "target": "SecuritySeverity",
      "from": "si_severity"
    },
    {
      "target": "cmdbId",
      "from": "si_cmdb_id"
    },
    {
      "target": "cmdbName",
      "from": "si_cmdb_name"
    },
    {
      "target": "ImpactedAssetCount",
      "from": "summary.ci_count"
    },
    {
      "target": "ImpactedAssets",
      "from": "summary.ci_names",
      "op": "join:;"
    },
    {
      "target": "RiskScoreTotal",
      "from": "summary.max_risk_score"
    },
    {
      "target": "RiskScoreTotal_Weighted",
      "from": "summary.max_weighted_risk_score"
    },
    {
      "target": "RiskRating",
      "from": "si_risk_rating"
    }
  ],
  "gridDefault": true
}
