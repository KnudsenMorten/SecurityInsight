{
  "$comment": "SecurityInsight risk-factor catalog -- risk factor model v2 (REQUIREMENTS #559, owner 2026-10-10: \"everything is a risk factor\", \"each of the risk factors will be linked to an risk score impact value (1-5)\", \"Sum, no cap\"). Template kind: risk-factor. Each factor is defined ONCE over SI fields (never provider fields) and carries: shortName = the name reports, Excel, PDF and mails show (PascalCase, precise wording, no editable number in it); name = its description in the GUI; appliesTo = asset (evaluated on the CI; adds to the ASSET side of the score) or finding (evaluated on the de-duplicated finding; adds to the VULNERABILITY side), never both; group = Exposure, Device health, Identity, Privilege, Apps, Importance, Exploitability, Impact, Severity or Lifecycle; class = builtin (always on: the engine refuses to switch it off, the web app too) or optional (the customer may switch it off); impact = 1..5 (very low .. very high), what the factor ADDS to its side of the score; state = enabled | disabled (a builtin factor is never disabled). THE SCORE: asset side = the risk index base (by finding x asset class x tier) + the SUM of the enabled asset factors' impacts; vulnerability side = the risk index base (by finding type / category / subcategory / severity) + the SUM of the enabled finding factors' impacts; no cap; risk score = asset side x vulnerability side (engine/risk-analysis/_shared/RA-RiskScore.ps1). axis = the report column the factor's short name is listed in (probability = RiskFactor_Probability_Detailed, consequence = RiskFactor_Consequence_Detailed) -- kept for the reports' CI blocks (si_rf_p / si_rf_c); the score side is appliesTo, never axis. Tier is never a factor (the risk index carries it); break glass is a classification (data-model list break_glass_patterns), not a factor. legacyTokens = the RF_* names / engine tokens this factor replaces, so the reports' tokens map to it and one factor counts once. evaluatedBy: catalog (this file decides) or report (computed inside one report's query). description = what the factor means to a person; combine = how its conditions join (any / all); providers = the provider fields that PROVE it, per provider, read from the field mappings (data-model/mappings) -- generated by Update-SIRiskFactorProviders (engine/data-model/SI-RiskFactorCatalog.ps1) and proven equal to the mappings by a test, never hand-edited; ciColumn = the factor gets its own SI_CI_CL column si_rf_<id>. A factor whose SI field is not mapped yet stays UNKNOWN (never a finding, #546). Customer overrides: risk-factors.custom.json (Pro: cfg.ItemOverride), per factor id -- impact, state (optional factors only) and the criteria (wizards).",
  "kind": "risk-factor",
  "version": "2.0.0",
  "groups": ["Exposure", "Device health", "Identity", "Privilege", "Apps", "Importance", "Exploitability", "Impact", "Severity", "Lifecycle"],
  "conditionOps": ["eq", "ne", "in", "not_in", "is_true", "is_false", "is_empty", "not_empty", "gt", "gte", "lt", "lte", "like", "contains", "contains_any", "matches", "older_than_days", "newer_than_days", "in_ranges", "in_list"],
  "factors": [
    { "id": "internet_exposed", "shortName": "InternetExposed", "name": "The asset can be reached from the internet", "appliesTo": "asset", "group": "Exposure", "class": "builtin", "impact": 4, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"azure":[{"siField":"si_internet_exposed","sources":["derived.isPubliclyExposed"],"recordTypes":["azure_resource"]}],"eg":[{"siField":"si_internet_exposed","sources":["node.NodeProperties.rawData.exposedToInternet.type","node.NodeProperties.rawData.hasInternetExposureSignal"],"recordTypes":["device","azure_resource","public_ip"]}],"mdc":[{"siField":"si_internet_exposed","sources":["exposure.internetExposed"],"recordTypes":["azure_resource"]}],"mde":[{"siField":"si_ip_addresses","sources":["machine.ipAddresses[*].ipAddress","machine.lastIpAddress"],"recordTypes":["device"]},{"siField":"si_internet_exposed","sources":["deviceInfo.IsInternetFacing"],"recordTypes":["device"]}],"servicenow":[{"siField":"si_ip_addresses","sources":["ci.ip_address"],"recordTypes":["cmdb_ci"]}],"shodan":[{"siField":"si_internet_exposed","sources":["host.ports"],"recordTypes":["public_ip"]}],"network":[{"siField":"si_ip_addresses","list":"internet_exposed_ranges","setting":"SI_InternetExposedRanges"}]},
      "description": "The asset can be reached from the internet: any provider says so (Defender for Endpoint internet-facing, Exposure Graph exposure, the Azure public-exposure derivation, Shodan open ports), or one of its addresses is in the customer's exposed network ranges (DMZ, online landing zones).", "combine": "any", "ciColumn": true,
      "legacyTokens": ["RF_P_InternetExposed", "RF_P_Internet", "InternetExposureSignal", "InternetFacingDevice"],
      "when": {"any":[{"field":"si_internet_exposed","op":"is_true"},{"field":"si_ip_addresses","op":"in_ranges","value":"internet_exposed_ranges"}]} },
    { "id": "high_risk_port_open", "shortName": "PortOpenInternet", "name": "An administrative or database port is open to the internet", "appliesTo": "asset", "group": "Exposure", "class": "builtin", "impact": 5, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"shodan":[{"siField":"si_open_ports","sources":["host.ports[*]"],"recordTypes":["public_ip"]}]},
      "description": "An administrative or database port is open to the internet (Shodan).", "combine": "all",
      "legacyTokens": ["RF_P_HighRiskPort", "AdminPort"],
      "when": {"all":[{"field":"si_open_ports","op":"contains_any","value":"high_risk_ports"}]} },
    { "id": "compromised_recently", "shortName": "RecentIncident", "name": "The asset was involved in a recent incident", "appliesTo": "asset", "group": "Exposure", "class": "builtin", "impact": 4, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"eg":[{"siField":"si_is_compromised_recently","sources":["node.NodeProperties.rawData.isCompromisedRecently"],"recordTypes":["device","user","service_principal","azure_resource"]}]},
      "description": "The asset was involved in a recent incident (Exposure Graph).", "combine": "all",
      "legacyTokens": ["IsCompromisedRecently"],
      "when": {"all":[{"field":"si_is_compromised_recently","op":"is_true"}]} },
    { "id": "unsupported_os", "shortName": "UnsupportedOS", "name": "The operating system is out of vendor security support", "appliesTo": "asset", "group": "Device health", "class": "builtin", "impact": 4, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"ad":[{"siField":"si_os_name","sources":["computer.operatingSystem"],"recordTypes":["device"]},{"siField":"si_os_platform","sources":["computer.operatingSystem"],"recordTypes":["device"]},{"siField":"si_os_version","sources":["computer.operatingSystemVersion"],"recordTypes":["device"]}],"azure":[{"siField":"si_os_platform","sources":["resource.properties.storageProfile.osDisk.osType"],"recordTypes":["azure_resource"]}],"eg":[{"siField":"si_os_name","sources":["node.NodeProperties.rawData.osPlatform","node.NodeProperties.rawData.osDistribution"],"recordTypes":["device"]},{"siField":"si_os_platform","sources":["node.NodeProperties.rawData.osPlatform"],"recordTypes":["device"]},{"siField":"si_os_version","sources":["node.NodeProperties.rawData.osVersion"],"recordTypes":["device"]}],"entra":[{"siField":"si_os_name","sources":["device.operatingSystem"],"recordTypes":["device"]},{"siField":"si_os_platform","sources":["device.operatingSystem"],"recordTypes":["device"]},{"siField":"si_os_version","sources":["device.operatingSystemVersion"],"recordTypes":["device"]}],"intune":[{"siField":"si_os_name","sources":["device.operatingSystem"],"recordTypes":["device"]},{"siField":"si_os_platform","sources":["device.operatingSystem"],"recordTypes":["device"]},{"siField":"si_os_version","sources":["device.osVersion"],"recordTypes":["device"]}],"mde":[{"siField":"si_os_name","sources":["machine.osPlatform","deviceInfo.OSPlatform"],"recordTypes":["device"]},{"siField":"si_os_platform","sources":["machine.osPlatform","deviceInfo.OSPlatform"],"recordTypes":["device"]},{"siField":"si_os_version","sources":["machine.osVersion","machine.version","deviceInfo.OSVersion"],"recordTypes":["device"]}]},
      "criteria": {"kind": "list", "list": "unsupported_os", "field": "si_os_name", "detailField": "si_os_version", "source": "collected"},
      "description": "The operating system is out of vendor security support (the unsupported_os list, matched on the OS name every device provider reports).", "combine": "all", "ciColumn": true,
      "legacyTokens": ["RF_P_LegacyEoS", "LegacyEndOfSupport"],
      "when": {"all":[{"field":"si_os_version","op":"in_list","value":"unsupported_os"}]} },
    { "id": "not_onboarded", "shortName": "NotOnboarded", "name": "The device is seen but not onboarded to Defender for Endpoint", "appliesTo": "asset", "group": "Device health", "class": "builtin", "impact": 3, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"eg":[{"siField":"si_onboarding_status","sources":["node.NodeProperties.rawData.onboardingStatus"],"recordTypes":["device"]}],"mde":[{"siField":"si_onboarding_status","sources":["machine.onboardingStatus","deviceInfo.OnboardingStatus"],"recordTypes":["device"]}]},
      "description": "The device is seen but not onboarded to Defender for Endpoint.", "combine": "all",
      "legacyTokens": ["Unonboarded"],
      "when": {"all":[{"field":"si_onboarding_status","op":"not_empty"},{"field":"si_onboarding_status","op":"ne","value":"onboarded"}]} },
    { "id": "antivirus_disabled", "shortName": "AVDisabled", "name": "Microsoft Defender Antivirus is disabled", "appliesTo": "asset", "group": "Device health", "class": "builtin", "impact": 4, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"mde":[{"siField":"si_av_status","sources":["deviceInfo.DefenderAvStatus","machine.defenderAvStatus"],"recordTypes":["device"]}]},
      "description": "Microsoft Defender Antivirus is disabled.", "combine": "all",
      "legacyTokens": ["DefenderAvDisabled"],
      "when": {"all":[{"field":"si_av_status","op":"eq","value":"disabled"}]} },
    { "id": "antivirus_out_of_date", "shortName": "AVOutOfDate", "name": "Microsoft Defender Antivirus signatures are out of date", "appliesTo": "asset", "group": "Device health", "class": "builtin", "impact": 3, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"mde":[{"siField":"si_av_status","sources":["deviceInfo.DefenderAvStatus","machine.defenderAvStatus"],"recordTypes":["device"]}]},
      "description": "Microsoft Defender Antivirus signatures are out of date.", "combine": "all",
      "legacyTokens": ["DefenderAvOutOfDate"],
      "when": {"all":[{"field":"si_av_status","op":"eq","value":"out_of_date"}]} },
    { "id": "excluded_from_defender", "shortName": "DefenderExcluded", "name": "The device is excluded in Defender", "appliesTo": "asset", "group": "Device health", "class": "builtin", "impact": 3, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"mde":[{"siField":"si_is_excluded","sources":["machine.isExcluded","deviceInfo.IsExcluded"],"recordTypes":["device"]}]},
      "description": "The device is excluded in Defender.", "combine": "all",
      "legacyTokens": ["Excluded"],
      "when": {"all":[{"field":"si_is_excluded","op":"is_true"}]} },
    { "id": "high_machine_risk", "shortName": "HighMachineRisk", "name": "Defender for Endpoint rates the machine's risk high", "appliesTo": "asset", "group": "Device health", "class": "builtin", "impact": 3, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"eg":[{"siField":"si_machine_risk","sources":["node.NodeProperties.rawData.machineRiskState"],"recordTypes":["device"]}],"mde":[{"siField":"si_machine_risk","sources":["machine.riskScore"],"recordTypes":["device"]}]},
      "description": "Defender for Endpoint rates the machine's risk high.", "combine": "all",
      "legacyTokens": ["HighMachineRisk", "RF_P_HighRiskDevice", "DeviceHighRiskScore"],
      "when": {"all":[{"field":"si_machine_risk","op":"eq","value":"high"}]} },
    { "id": "unmanaged", "shortName": "Unmanaged", "name": "No management agent manages the device", "appliesTo": "asset", "group": "Device health", "class": "optional", "impact": 2, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"intune":[{"siField":"si_managed_by","sources":["device.managementAgent"],"recordTypes":["device"]}],"mde":[{"siField":"si_managed_by","sources":["machine.managedBy","deviceInfo.DeviceManagementType"],"recordTypes":["device"]}]},
      "description": "No management agent manages the device.", "combine": "all",
      "legacyTokens": ["Unmanaged"],
      "when": {"all":[{"field":"si_managed_by","op":"eq","value":"unmanaged"}]} },
    { "id": "no_mfa", "shortName": "NoMFA", "name": "A user or guest with no MFA method registered", "appliesTo": "asset", "group": "Identity", "class": "builtin", "impact": 3, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"eg":[{"siField":"si_mfa_registered","sources":["node.NodeProperties.rawData.isMfaRegistered"],"recordTypes":["user"]}],"entra":[{"siField":"si_mfa_registered","sources":["registration.isMfaRegistered"],"recordTypes":["user"]}]},
      "description": "A user or guest with no MFA method registered (Entra registration details, else the Exposure Graph identity node). A registration that could not be read is unknown, never \"no MFA\".", "combine": "all", "ciColumn": true,
      "legacyTokens": ["RF_P_NoMFA", "NoMfaIsRegistered"],
      "when": {"all":[{"field":"si_identity_type","op":"in","value":["user","guest"]},{"field":"si_mfa_registered","op":"is_false"}]} },
    { "id": "old_password", "shortName": "OldPassword", "name": "The password of a user or guest has not been changed for a long time", "appliesTo": "asset", "group": "Identity", "class": "builtin", "impact": 3, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"ad":[{"siField":"si_password_last_changed","sources":["user.pwdLastSet"],"recordTypes":["user"]}],"eg":[{"siField":"si_password_last_changed","sources":["node.NodeProperties.rawData"],"recordTypes":["user"]}],"entra":[{"siField":"si_password_last_changed","sources":["user.lastPasswordChangeDateTime"],"recordTypes":["user"]},{"siField":"si_password_last_changed","sources":["profile.LastPasswordChangeDateTime"],"recordTypes":["user"]}]},
      "criteria": {"kind": "threshold", "field": "si_password_last_changed", "op": "older_than_days", "min": 30, "max": 3650, "unit": "days", "source": "enum"},
      "description": "The password of a user or guest has not been changed for a year: si_password_last_changed by the field authority of the identity's origin (a synchronised account: Active Directory pwdLastSet, never Entra; a cloud-only one: Entra). A password age that was never read, or that the authoritative provider did not report, is unknown -- never old.", "combine": "all", "ciColumn": true,
      "legacyTokens": ["RF_P_OldPassword", "PasswordOver365Days", "PasswordOver730Days"],
      "when": {"all":[{"field":"si_identity_type","op":"in","value":["user","guest"]},{"field":"si_password_last_changed","op":"older_than_days","value":365}]} },
    { "id": "leaked_credentials", "shortName": "LeakedCreds", "name": "Credentials of the identity were found leaked", "appliesTo": "asset", "group": "Identity", "class": "builtin", "impact": 5, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"eg":[{"siField":"si_has_leaked_credentials","sources":["node.NodeProperties.rawData.hasLeakedCredentials","node.NodeProperties.rawData.hasAdLeakedCredentials"],"recordTypes":["user"]}]},
      "$note": "new in 3.1 -- enters as testing (counts 0) until promoted",
      "description": "Credentials of the identity were found leaked (Exposure Graph).", "combine": "all",
      "legacyTokens": [],
      "when": {"all":[{"field":"si_has_leaked_credentials","op":"is_true"}]} },
    { "id": "identity_at_risk", "shortName": "IdentityAtRisk", "name": "Defender for Identity rates the identity at risk", "appliesTo": "asset", "group": "Identity", "class": "builtin", "impact": 4, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"mdi":[{"siField":"si_mdi_risk_state","sources":["identity.riskState","identity.RiskStatus","identity.RiskLevel"],"recordTypes":["user"]}]},
      "description": "Defender for Identity rates the identity at risk.", "combine": "all",
      "legacyTokens": ["RF_P_AtRisk", "RF_P_HighRisk", "MDI_AtRisk"],
      "when": {"all":[{"field":"si_mdi_risk_state","op":"in","value":["at_risk","high"]}]} },
    { "id": "identity_high_blast_radius", "shortName": "HighBlastRadius", "name": "Defender for Identity rates the identity's blast radius high", "appliesTo": "asset", "group": "Importance", "class": "builtin", "impact": 3, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"mdi":[{"siField":"si_mdi_blast_radius","sources":["identity.BlastRadius","identity.blastRadius"],"recordTypes":["user"]}]},
      "description": "Defender for Identity rates the identity's blast radius high.", "combine": "all", "ciColumn": true,
      "legacyTokens": ["RF_P_HighBlastRadius"],
      "when": {"all":[{"field":"si_mdi_blast_radius","op":"eq","value":"high"}]} },
    { "id": "stale_sign_in", "shortName": "EnabledNoSignInStale", "name": "An enabled identity with no sign-in for a long time (days editable)", "appliesTo": "asset", "group": "Lifecycle", "class": "optional", "impact": 2, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"ad":[{"siField":"si_account_enabled","sources":["computer.userAccountControl","user.userAccountControl"],"recordTypes":["device","user"]},{"siField":"si_last_sign_in","sources":["user.lastLogonTimestamp"],"recordTypes":["user"]}],"eg":[{"siField":"si_account_enabled","sources":["node.NodeProperties.rawData.accountEnabled","node.NodeProperties.rawData.isEnabled"],"recordTypes":["user","service_principal"]}],"entra":[{"siField":"si_account_enabled","sources":["user.accountEnabled"],"recordTypes":["user"]},{"siField":"si_last_sign_in","sources":["user.signInActivity.lastSuccessfulSignInDateTime","user.signInActivity.lastSignInDateTime","user.signInActivity.lastNonInteractiveSignInDateTime"],"recordTypes":["user"]},{"siField":"si_account_enabled","sources":["sp.accountEnabled"],"recordTypes":["service_principal"]},{"siField":"si_last_sign_in","sources":["signIn.lastSignInActivity.lastSignInDateTime"],"recordTypes":["service_principal"]},{"siField":"si_account_enabled","sources":["device.accountEnabled"],"recordTypes":["device"]},{"siField":"si_last_sign_in","sources":["profile.LastSignInDateTime"],"recordTypes":["user","service_principal"]}],"mdi":[{"siField":"si_account_enabled","sources":["identity.IsAccountEnabled"],"recordTypes":["user"]},{"siField":"si_last_sign_in","sources":["identity.lastSeenActivity"],"recordTypes":["user"]}]},
      "criteria": {"kind": "threshold", "field": "si_last_sign_in", "op": "older_than_days", "min": 7, "max": 3650, "unit": "days", "source": "enum"},
      "$note": "today the reports use 90 or 180 days; one definition now (90)",
      "description": "An ENABLED identity with no sign-in for 90 days (editable) -- identities only: a device or resource has no sign-in. The newest sign-in the providers authoritative for the identity's origin report (a synchronised account: Active Directory / Defender for Identity, with Entra; a cloud-only one: Entra). One stale factor: the days are the criteria (the former \"no sign-in for a year\" is this factor with more days). No sign-in recorded is NeverSignedIn; a sign-in or an enabled state the CI cannot decide is unknown, never stale.", "combine": "all", "ciColumn": true,
      "legacyTokens": ["RF_P_Stale", "RF_P_StaleLogin", "StaleLastLogin", "StaleLastSignIn", "RF_P_VeryStale", "StaleOver365Days", "NoSignInStale", "NoSignInVeryStale"],
      "when": {"all":[{"field":"si_identity_type","op":"in","value":["user","guest","service_principal"]},{"field":"si_account_enabled","op":"is_true"},{"field":"si_last_sign_in","op":"older_than_days","value":90}]} },
    { "id": "never_signed_in", "shortName": "NeverSignedIn", "name": "An identity that has never signed in", "appliesTo": "asset", "group": "Lifecycle", "class": "optional", "impact": 2, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"ad":[{"siField":"si_last_sign_in","sources":["user.lastLogonTimestamp"],"recordTypes":["user"]}],"entra":[{"siField":"si_last_sign_in","sources":["user.signInActivity.lastSuccessfulSignInDateTime","user.signInActivity.lastSignInDateTime","user.signInActivity.lastNonInteractiveSignInDateTime"],"recordTypes":["user"]},{"siField":"si_last_sign_in","sources":["signIn.lastSignInActivity.lastSignInDateTime"],"recordTypes":["service_principal"]},{"siField":"si_last_sign_in","sources":["profile.LastSignInDateTime"],"recordTypes":["user","service_principal"]}],"mdi":[{"siField":"si_last_sign_in","sources":["identity.lastSeenActivity"],"recordTypes":["user"]}]},
      "description": "An identity that has never signed in: the provider that decides the sign-in for the identity's origin is linked and reports none (a synchronised account: Active Directory; a cloud-only one: Entra). Without that provider the sign-in is unknown, never 'never signed in'.", "combine": "all", "ciColumn": true,
      "legacyTokens": ["RF_P_NeverLoggedIn", "NeverAuthenticated"],
      "when": {"all":[{"field":"si_identity_type","op":"in","value":["user","guest","service_principal"]},{"field":"si_last_sign_in","op":"is_empty"}]} },
    { "id": "old_account", "shortName": "OldAccount", "name": "An identity created long ago (days editable)", "appliesTo": "asset", "group": "Lifecycle", "class": "optional", "impact": 1, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"ad":[{"siField":"si_created","sources":["computer.whenCreated","user.whenCreated"],"recordTypes":["device","user"]}],"azure":[{"siField":"si_created","sources":["resource.properties.timeCreated","resource.properties.creationTime","resource.systemData.createdAt"],"recordTypes":["azure_resource"]}],"entra":[{"siField":"si_created","sources":["user.createdDateTime"],"recordTypes":["user"]},{"siField":"si_created","sources":["device.registrationDateTime","device.createdDateTime"],"recordTypes":["device"]},{"siField":"si_created","sources":["profile.CreatedDateTime","sp.createdDateTime"],"recordTypes":["service_principal"]}]},
      "criteria": {"kind": "threshold", "field": "si_created", "op": "older_than_days", "min": 1, "max": 3650, "unit": "days", "source": "enum"},
      "description": "An identity (user, guest or service principal) created more than 90 days ago -- identities only: a device or resource is not an account.", "combine": "all",
      "legacyTokens": ["RF_P_VeryOld", "AccountOver90DaysOld"],
      "when": {"all":[{"field":"si_identity_type","op":"in","value":["user","guest","service_principal"]},{"field":"si_created","op":"older_than_days","value":90}]} },
    { "id": "permanent_privileged_role", "shortName": "PermanentAdmin", "name": "A Tier 0 / Tier 1 role held permanently, not just-in-time", "appliesTo": "asset", "group": "Privilege", "class": "optional", "impact": 2, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"entra":[{"siField":"si_privilege_tier_permanent","sources":["profile.EntraRolesPermanentVerdict_Tier"],"recordTypes":["user","service_principal"]}]},
      "description": "A Tier 0 / Tier 1 role held permanently (not just-in-time).", "combine": "all",
      "legacyTokens": ["RF_P_Permanent", "RF_P_AlsoPermanent", "AlsoPermanentAssignment", "PermanentAssignment", "PermanentRole", "PermanentRoleAssignment"],
      "when": {"all":[{"field":"si_privilege_tier_permanent","op":"lte","value":1}]} },
    { "id": "has_secret", "shortName": "ClientSecret", "name": "The service principal authenticates with a client secret", "appliesTo": "asset", "group": "Apps", "class": "builtin", "impact": 3, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"entra":[{"siField":"si_has_client_secret","sources":["sp.passwordCredentials[*].keyId","app.passwordCredentials[*].keyId"],"recordTypes":["service_principal"]}]},
      "description": "The service principal authenticates with a client secret (a password), not only a certificate or a managed identity: a secret leaks more easily.", "combine": "all", "ciColumn": true,
      "legacyTokens": ["RF_P_HasSecret", "HasClientSecret"],
      "when": {"all":[{"field":"si_has_client_secret","op":"is_true"}]} },
    { "id": "no_owner", "shortName": "NoOwner", "name": "A service principal or application without an owner", "appliesTo": "asset", "group": "Apps", "class": "optional", "impact": 2, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"entra":[{"siField":"si_is_orphan_sp","sources":["derived.ownerCount"],"recordTypes":["service_principal"]},{"siField":"si_is_orphan_sp","sources":["profile.IsOrphanSPN"],"recordTypes":["service_principal"]}]},
      "description": "A service principal / application with no owner: nobody answers for its credentials and permissions.", "combine": "all", "ciColumn": true,
      "legacyTokens": ["RF_P_NoOwner"],
      "when": {"all":[{"field":"si_is_orphan_sp","op":"is_true"}]} },
    { "id": "expired_credentials", "shortName": "CredsExpired", "name": "The service principal holds an expired secret or certificate", "appliesTo": "asset", "group": "Apps", "class": "optional", "impact": 2, "state": "enabled", "axis": "probability", "evaluatedBy": "catalog",
      "providers": {"entra":[{"siField":"si_credential_expiry_days","sources":["derived.credentialExpiryDays"],"recordTypes":["service_principal"]},{"siField":"si_credential_expiry_days","sources":["profile.CredentialExpiryDays"],"recordTypes":["service_principal"]}]},
      "description": "The service principal holds an expired secret or certificate.", "combine": "all",
      "legacyTokens": ["RF_P_HasExpired", "RF_P_AlreadyExpired", "ExpiredCredential"],
