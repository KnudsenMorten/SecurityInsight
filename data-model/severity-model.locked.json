{
  "$comment": "SecurityInsight severity model (REQUIREMENTS #690 (15), owner 2026-10-15: \"all security findings must have severity\" / \"it comes from different metrics, often impact score or directly from the source\" / \"report can easily have a model for mapping the impact score into severity\" / \"unknown is not supported in any report\" / \"field must be normalized\"). ONE model: every report declares an ORDERED list of metric kinds; the first kind whose metric the row carries decides the severity, owner_defined is always last, so every row ends with exactly one of the five SI values in scale. source_severity = the provider's own severity word through sourceMap; cvss / epss / secure_score_impact / attack_path_priority = an impact score through its bands (first band whose min the score reaches; a missing score = the next kind); tier = the asset tier; owner_defined = the report's own severity (pre-filled with the severity each report declared before this model, so nothing changed; validated false = waiting for the owner's weekly validation). The model is loaded and validated (SI-DataModelTemplates.ps1: Get-SISeverityModel / Resolve-SISeverity / Test-SISeverityModel); the reports' queries do not read it yet -- the generated severity block is the next step. Pro: overridden per report like every data-model item (cfg.ItemOverride datamodel severity-model:<report>).",
  "kind": "severity-model",
  "version": "1.0.0",
  "scale": [
    "Very High",
    "High",
    "Medium-High",
    "Medium",
    "Low"
  ],
  "models": [
    {
      "id": "source_severity",
      "type": "map",
      "description": "the provider's own severity word or level (Defender vulnerability management, Defender for Cloud, Defender for Identity, Entra)",
      "map": {
        "critical": "Very High",
        "very high": "Very High",
        "high": "High",
        "medium-high": "Medium-High",
        "medium": "Medium",
        "moderate": "Medium",
        "low": "Low"
      }
    },
    {
      "id": "cvss",
      "type": "bands",
      "description": "CVSS base score 0-10 (owner 2026-10-15: >=9 Very High, >=7 High, >=4 Medium, >0 Low)",
      "bands": [
        {
          "min": 9,
          "severity": "Very High"
        },
        {
          "min": 7,
          "severity": "High"
        },
        {
          "min": 4,
          "severity": "Medium"
        },
        {
          "min": 0.1,
          "severity": "Low"
        }
      ]
    },
    {
      "id": "epss",
      "type": "bands",
      "description": "EPSS exploit probability 0-1 -- PROPOSED bands, waiting for the owner",
      "validated": false,
      "bands": [
        {
          "min": 0.5,
          "severity": "Very High"
        },
        {
          "min": 0.1,
          "severity": "High"
        },
        {
          "min": 0.01,
          "severity": "Medium"
        },
        {
          "min": 1E-06,
          "severity": "Low"
        }
      ]
    },
    {
      "id": "secure_score_impact",
      "type": "bands",
      "description": "Defender secure-configuration impact 0-10 (the bands the device reports use today: 10 Very High, 9 High, 8 Medium-High, >=5 Medium, else Low)",
      "bands": [
        {
          "min": 10,
          "severity": "Very High"
        },
        {
          "min": 9,
          "severity": "High"
        },
        {
          "min": 8,
          "severity": "Medium-High"
        },
        {
          "min": 5,
          "severity": "Medium"
        },
        {
          "min": 0,
          "severity": "Low"
        }
      ]
    },
    {
      "id": "attack_path_priority",
      "type": "bands",
      "description": "the attack path's own priority score (the bands the attack-path reports use today: >=90 Very High, >=60 High, >=30 Medium-High, >=15 Medium, else Low)",
      "bands": [
        {
          "min": 90,
          "severity": "Very High"
        },
        {
          "min": 60,
          "severity": "High"
        },
        {
          "min": 30,
          "severity": "Medium-High"
        },
        {
          "min": 15,
          "severity": "Medium"
        },
        {
          "min": 0,
          "severity": "Low"
        }
      ]
    },
    {
      "id": "tier",
      "type": "map",
      "description": "the asset tier (owner 2026-10-15: 0 Very High, 1 High, 2 Medium, 3 Low)",
      "map": {
        "0": "Very High",
        "1": "High",
        "2": "Medium",
        "3": "Low"
      }
    },
    {
      "id": "owner_defined",
      "type": "fixed",
      "description": "the report's own severity (ownerDefined), always last -- every row gets a severity"
    }
  ],
  "reports": [
