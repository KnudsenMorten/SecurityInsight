# SecurityInsight Pro MCP server (read-only estate tools, streamable HTTP at /mcp, Entra bearer required).
#
# A SEPARATE image and Container App from the web app: it is its own ASP.NET Core process (SI.Management.Mcp) with
# its own authentication (JwtBearer access tokens, not the web app's sign-in cookie), so it cannot share the web
# app's process or port. It shares SI.Management.Core -- the same curated tools the web app's chat calls in-process.
#
# BUILD CONTEXT: the same staged folder as ./Dockerfile (deploy\Deploy-SIManagement.ps1 -Apply builds both):
#   az acr build --registry <acr> --image si-management-mcp:<tag> --file pro-management/Dockerfile.mcp <stage>

# Base images pinned by digest and the .NET restore locked (packages.lock.json, --locked-mode): see ./Dockerfile.
FROM mcr.microsoft.com/dotnet/sdk:10.0@sha256:212fe4cb74627d5adf9817a4088906ae3edff1bd853bb27565d4b46731efe61e AS build
WORKDIR /src
COPY pro-management/src/SI.Management.Core/SI.Management.Core.csproj pro-management/src/SI.Management.Core/packages.lock.json pro-management/src/SI.Management.Core/
COPY pro-management/src/SI.Management.Mcp/SI.Management.Mcp.csproj pro-management/src/SI.Management.Mcp/packages.lock.json pro-management/src/SI.Management.Mcp/
RUN dotnet restore pro-management/src/SI.Management.Mcp/SI.Management.Mcp.csproj --locked-mode
COPY pro-management/src/SI.Management.Core/ pro-management/src/SI.Management.Core/
COPY pro-management/src/SI.Management.Mcp/ pro-management/src/SI.Management.Mcp/
RUN dotnet publish pro-management/src/SI.Management.Mcp/SI.Management.Mcp.csproj -c Release -o /app --no-restore -p:UseAppHost=false

# IMAGE-PATCH-1 (2026-11-10): the runtime is Ubuntu 24.04 CHISELED (no shell, no package manager; non-root by default). The
# -extra flavour (ICU + tzdata) because the MCP server answers with the same culture-formatted values as the web app.
FROM mcr.microsoft.com/dotnet/aspnet:10.0-noble-chiseled-extra@sha256:a9298ccc39c6258ae71228479e2f3f8d2ceb6639a9927262a4b0ff7d319a0e7e AS runtime
WORKDIR /app
COPY --from=build /app .
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_RUNNING_IN_CONTAINER=true \
    ASPNETCORE_ENVIRONMENT=Production
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "SI.Management.Mcp.dll"]
