      ]
    },
    "public-ip": {
      "class": "public_ip",
      "recordTypes": [
        "public_ip"
      ]
    },
    "vulnerability": {
      "finding": "vulnerability"
    },
    "recommendation": {
      "finding": "recommendation"
    }
  },
