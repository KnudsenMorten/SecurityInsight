@* Title, what the view shows, the collection picker and the page's notices -- the top of every collection view (#1386: one line). *@
@model SI.Management.Web.Pages.Collection.CollectionPageModel
@inject SI.Management.Web.Collection.IPartialCollections PartialMarks
@inject SI.Management.Web.Collection.ISourceNotes SourceNotes
@{
    ViewData["Title"] = Model.Heading;
    // a collection an Admin released although its run was incomplete is MARKED PARTIAL wherever it is shown
    var marks = await PartialMarks.MarksAsync(default);
    var currentMark = Model.Current is { } cur && marks.TryGetValue(cur.CollectionId, out var cm) ? cm : null;
    // per report (owner 2026-10-19): only on a page that shows one of those reports, in plain words; the cause for Admins only
    var partialNotice = SI.Management.Web.Collection.PartialNotice.For(currentMark, Model.PagePath, User.IsAdmin());
    // a collection calculated while a source was on its last good collection says so -- unless the page's own banner (the
    // state of the sources NOW, in the layout) already says the same of the newest collection
    var srcNow = await SourceNotes.CurrentAsync(default);
    var srcOf = Model.Current is { } srcCur && (await SourceNotes.ByCollectionAsync(default)).TryGetValue(srcCur.CollectionId, out var srcList) ? srcList : null;
    var srcNewest = Model.Current is not null && Model.Collections.Count > 0 && Model.Collections[0].CollectionId == Model.Current.CollectionId;
    var srcShow = srcOf is null ? new List<SI.Management.Web.Collection.SourceNote>() : srcOf.Where(n => !(srcNewest && srcNow.Any(x => x.Source == n.Source))).ToList();
    var scope = Model.Current is not null ? await Model.ScopeAsync(ViewContext.HttpContext.RequestAborted) : null;
    var countGrid = Model.Grid;
    var older = SI.Management.Web.Pages.Collection.ViewHead.IsOlder(Model.Current, Model.Collections);
    // #1386 what this header showed, for the layout's run line and the grid's count heading (the body renders before the layout)
    if (Model.Current is not null) { ViewContext.HttpContext.Items[SI.Management.Web.Pages.Collection.ViewHead.RunShownKey] = true; }
    if (countGrid is not null) { ViewContext.HttpContext.Items[SI.Management.Web.Pages.Collection.ViewHead.CountedGridKey] = countGrid; }
}
@* #1386 (owner 2026-11-25, "One line"): the title with "About this page" beside it -- the page's explanation, the "What you're
   looking at" statement and "What these words mean" inside it, every word kept -- then ONE line: the grid's row count and
   the collection picker, which shows the collection's date (the one place a view shows it). ViewHead.cs. *@
<div class="view-head" data-view-head>
    <h1>@Model.Heading</h1>
    <details class="about" data-about><summary>About this page</summary><p class="lede">@Model.Lede</p>@if (scope is not null) { <partial name="~/Pages/Shared/_ViewScope.cshtml" model="scope" view-data='new ViewDataDictionary(ViewData) { ["ViewScopeInAbout"] = true }' /> }</details>
</div>
@* #636 the view picker (Security recommendations > Summary / Detailed) *@
@if (Model.Picker is { } picker) { <partial name="~/Pages/Shared/_ViewPicker.cshtml" model="picker" /> }
@if (countGrid is not null || Model.Collections.Count > 0 || Model.Current is not null)
{
    <div class="view-line" data-view-line>
        @if (countGrid is not null) { <strong data-view-count>@SI.Management.Web.Pages.Collection.ViewHead.Count(countGrid.Total, Model.RowNoun)</strong> }
        @if (Model.Collections.Count > 0)
        {
            if (countGrid is not null) { <span class="vs-sep" aria-hidden="true">·</span> }
            <form method="get" action="@Model.PagePath" class="picker" data-autosubmit aria-label="Collection">
                @foreach (var (k, v) in Model.ExtraState()) { <input type="hidden" name="@k" value="@v" /> }
                <label for="pick-c">data from <span class="sr-only">the collection</span></label>
                <select id="pick-c" name="c">
                    @foreach (var c in Model.Collections)
                    {
                        <option data-utc value="@c.CollectionId" selected="@(c.CollectionId == Model.Current?.CollectionId)">@Fmt.When(c.CollectionTime)@(c.Rows is { } n ? " · " + Fmt.Int(n) + " rows" : "")@(c == Model.Collections[0] ? " · newest" : "")@(marks.TryGetValue(c.CollectionId, out var pm) && !pm.PerReport && pm.ShowsOn(Model.PagePath) ? " · " + pm.Badge : "")</option>
                    }
                </select>
                <noscript><button type="submit">Open</button></noscript>
            </form>
        }
        else if (Model.Current is { } only)
        {
            if (countGrid is not null) { <span class="vs-sep" aria-hidden="true">·</span> }
            <span data-view-run>data from @Fmt.Time(only.CollectionTime)</span>
        }
        @if (older)
        {
            @* a collection older than the newest is never mistaken for the current state *@
            <span class="badge warn" data-older-collection>@SI.Management.Web.Pages.Collection.ViewHead.OlderMark</span>
            <a href="@Model.Link(("c", Model.Collections[0].CollectionId))" data-open-newest>@SI.Management.Web.Pages.Collection.ViewHead.OpenNewest</a>
        }
    </div>
}
@* the person's filters stay in sight, as removable chips (the rest of the statement is in About) *@
@if (scope is not null) { <partial name="~/Pages/Shared/_ViewScopeChips.cshtml" model="scope" /> }
@* #855 the grid's CI lifecycle: Active (the default) | Not seen | Retired | All -- only where the grid counts it *@
@if (Model.LifecycleChoiceModel is { } lifeChoice) { <partial name="~/Pages/Shared/_LifecycleChoice.cshtml" model="lifeChoice" /> }
@if (Model.Error is not null)
{
    @* #284: a failed or timed-out read says so in the page, with the reference that finds it in the log *@
    <div class="notice error" role="alert" data-view-error="@(Model.TimedOut ? "timeout" : "failed")" data-ref="@Model.ErrorRef">@Model.Error@if (Model.TimedOut) { <text> </text><a href="@Model.Link()">Try again</a> }</div>
}
@if (partialNotice is not null) { <partial name="~/Pages/Shared/_PartialNotice.cshtml" model="partialNotice" /> }
@foreach (var srcNote in srcShow) { <div class="notice warn" role="status" data-utc data-collection-source="@srcNote.Source">When this collection was calculated: @(srcNote.Text(t => Fmt.When(t)))</div> }
@if (Model.Notice is not null) { <div class="notice warn" role="status">@Model.Notice</div> }
@* #1189: what the search matched (the fast search off an index) and the way to search anywhere in the text -- never a narrowed answer shown as the whole one *@
@if (Model.SearchNote is { } sn) { <div class="notice" role="status" data-search-note="@(sn.Anywhere ? "anywhere" : "fast")">@sn.Text <a href="@sn.Href" data-search-anywhere="@(sn.Anywhere ? "off" : "on")">@sn.LinkText</a></div> }
