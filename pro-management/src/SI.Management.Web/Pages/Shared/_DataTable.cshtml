@model SI.Management.Web.Columns.DataTableView
@using SI.Management.Web.Columns
@using SI.Management.Core.ProData
@* #589 THE table of a data view that is not a SQL grid: the columns the person chose (own + the CI, its identifiers,
   linked objects, source properties, the finding context), the chooser, the all-rows exports with exactly those columns,
   and Export all columns. Sorted in the browser (data-sortable), or by the server when the list is paged (ServerSort). *@
@{
    var t = Model.Table;
    var keys = t.Shown;
    var selectable = t.SelectName is not null && t.SelectValue is not null;
    // a row's start tag: its CI key, then the page's own attributes (one space between, none empty)
    string RowStart(object row)
    {
        var parts = new List<string>();
        if (t.RefOf?.Invoke(row).Ci is { Length: > 0 } key) parts.Add("data-key=\"" + System.Net.WebUtility.HtmlEncode(key) + "\"");
        if (t.RowAttributes?.Invoke(row) is { } a)
            parts.AddRange(a.Where(x => x.Value is not null).Select(x => x.Key + "=\"" + System.Net.WebUtility.HtmlEncode(x.Value) + "\""));
        return "<tr" + string.Concat(parts.Select(p => " " + p)) + ">";
    }
    var tableStart = "<table" + (t.ServerSort is null ? " data-sortable" : " class=\"findings\"") + " id=\"dt-" + System.Net.WebUtility.HtmlEncode(t.Id) + "\""
        + (t.Marker is null ? "" : " " + t.Marker) + ">";
}
<div class="dataview" data-data-table="@t.Id" data-view="@t.View">
    <div class="split">
        <span class="muted">@Fmt.Int(t.Rows.Count) row(s)</span>
        @if (!Model.InForm) { <partial name="~/Pages/Shared/_ViewExports.cshtml" model="Model.Exports" /> }
    </div>
    @if (!Model.InForm) { <partial name="~/Pages/Shared/_ColumnChooser.cshtml" model="Model.Chooser" /> }
    @if (t.Rows.Count == 0) { <p class="hint" data-empty>@t.Empty</p> }
    <div class="table-wrap">
        @Html.Raw(tableStart)
            <thead>
                <tr>
                    @if (selectable) { <th class="sel"><input type="checkbox" data-select-all aria-label="Select every row on this page" /></th> }
                    @foreach (var k in keys)
                    {
                        var c = t.Column(k);
                        if (c is not null && t.ServerSort?.Invoke(k) is { } s)
                        {
                            <th scope="col" data-col="@k" class="@(c.Number ? "num" : null)" aria-sort="@s.AriaSort"><a href="@s.Href" data-sort="@s.Token">@t.Label(k)@s.Arrow</a></th>
                            continue;
                        }
                        <th scope="col" data-col="@k" class="@(c?.Number == true ? "num" : null)" title="@c?.Description">@t.Label(k)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var row in t.Rows)
                {
                    <text>@Html.Raw(RowStart(row))</text>
                    if (selectable) { <td class="sel"><input form="@t.SelectForm" type="checkbox" name="@t.SelectName" value="@(t.SelectValue!(row))" data-select-row aria-label="Select this row" /></td> }
                    foreach (var k in keys)
                    {
                            var c = t.Column(k);
                            if (c is not null && t.Html.TryGetValue(k, out var html))
                            {
                                <td data-col="@k" class="@(c.Number ? "num" : "wrap")">@html(row)</td>
                                continue;
                            }
                            var text = t.Text(row, k);
                            if (c is null)
                            {
                                <td data-col="@k" data-extra class="wrap">@DataCellHtml.Render(text)</td>
                                continue;
                            }
                            var href = text.Length == 0 ? null : c.Link?.Invoke(row);
                            var raw = c.Value(row);
                            // a moment is an element the browser shows in the viewer's own zone, never the server's own
                            // text for it (a column with words of its own keeps them)
                            var moment = c.Text is not null ? null : raw is DateTime dt ? Fmt.Time(dt) : raw is DateTimeOffset dto ? Fmt.Time(dto) : null;
                            if (moment is not null)
                            {
                                <td data-col="@k" class="wrap">@if (href is not null) { <a href="@href">@moment</a> } else { @moment }</td>
                                continue;
                            }
                            var cell = href is null ? (Microsoft.AspNetCore.Html.IHtmlContent)new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(text))
                                : new Microsoft.AspNetCore.Html.HtmlString("<a href=\"" + System.Net.WebUtility.HtmlEncode(href) + "\">" + System.Net.WebUtility.HtmlEncode(text) + "</a>");
                            <td data-col="@k" class="@(c.Number ? "num" : "wrap")" data-value="@(raw is DateTime d ? d.ToString("o", System.Globalization.CultureInfo.InvariantCulture) : raw is double or int or long ? Convert.ToString(raw, System.Globalization.CultureInfo.InvariantCulture) : null)">@cell</td>
                        }
                        <text>@Html.Raw("</tr>")</text>
                }
            </tbody>
        @Html.Raw("</table>")
    </div>
</div>
