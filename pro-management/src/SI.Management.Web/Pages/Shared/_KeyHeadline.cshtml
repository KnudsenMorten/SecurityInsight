@model SI.Management.Web.RiskExec.ExecutiveFigures
@using SI.Management.Web.RiskExec
@* #636: the headline figures on top of BOTH the Executive overview and the Executive report -- the same stored rows, the
   same partial, so the two can never show different numbers (a test compares them). Each opens its topic.
   owner 2026-10-20: a Protection Score tile has its headline larger and its value smaller (balanced, app.css .ps-tile), and
   the accepted lifecycle's actual values under the "within Accepted Lifecycle" score.
   #1360 (owner 2026-11-25): each Protection Score tile has an (i) with the formula, beside the tile's link (.ps-host). *@
@{
    var psInfo = Model.Info;
    async Task Tile(string key, bool ps)
    {
        var l = Model.Headline(key);
        <a class="tile@(ps ? " ps-tile" : "")" href="@l.Href" data-headline="@key" data-value="@Fmt.Raw(l.Raw)">
            <div class="label@(ps ? " ps-cap" : "")">@l.Label</div>
            <div class="value@(ps ? " ps-value" : "")">@l.Value</div>
            @if (l.Change is { } ch) { await Html.RenderPartialAsync("_ChangeSince", ch); }
            @if (l.Note is not null) { <div class="delta muted">@l.Note</div> }
            @* #1382 (owner 2026-11-25: "the formula is also missing" / "this is for executives"): both score tiles say in plain words
               how the score is worked out, and the one difference between them; the (i) holds the full calculation *@
            @if (key == "protection_lifecycle") { <div class="ps-explain" data-lifecycle-line>@ExecWords.LifecycleLine(Model.Lifecycle, Model.Model)</div> }
            @if (key == "protection_technical") { <div class="ps-explain" data-actual-line>@ExecWords.ActualLine(Model.Model)</div> }
            @if (ps) { <div class="ps-explain ps-hint" data-ps-hint>@ExecWords.InfoHint</div> }
        </a>
    }
}
<div class="tiles kf-headline" data-kf-headline>
    @foreach (var h in ExecutiveFigures.Headlines)
    {
        if (h.Key.StartsWith("protection_", StringComparison.Ordinal))
        {
            <div class="ps-host">
                @{ await Tile(h.Key, true); }
                <partial name="_ProtectionScoreInfo" model="psInfo" />
            </div>
        }
        else
        {
            await Tile(h.Key, false);
        }
    }
</div>
