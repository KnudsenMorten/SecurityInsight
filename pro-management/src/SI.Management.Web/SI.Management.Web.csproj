<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SI.Management.Web</RootNamespace>
    <!-- mgmt1 blocks native executables (ASR): dll-only, run with `dotnet SI.Management.Web.dll`. -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <!-- The header's version pill + the footer show the SecurityInsight release: the solution's VERSION file (the deploy
       stage copies it next to config\). Without it the app shows no version rather than a made-up one. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\VERSION')">
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\..\VERSION').Trim())</Version>
  </PropertyGroup>

  <!-- The build this app is (BUILD.json: version, "3.0.0-rc.12" display, commit, build time), stamped ONCE at image build
       time by Deploy-SIManagement.ps1 into the stage next to VERSION. It is copied next to the app, where AppInfo reads it;
       without it the app shows the VERSION above and "build unknown". -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\BUILD.json')">
    <Content Include="..\..\..\BUILD.json" Link="BUILD.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Web" Version="3.14.1" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SI.Management.Core\SI.Management.Core.csproj" />
  </ItemGroup>

  <!-- The settings catalog is the Community page's own (generated, locked). It is LINKED, never copied, so the Pro page
       validates by the same catalog the PowerShell reader/writer uses. -->
  <ItemGroup>
    <Content Include="..\..\..\config\settings.catalog.locked.json" Link="catalog\settings.catalog.locked.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- #260: the audit trail's closed action list, the same file the PowerShell writer reads (engine\pro-settings\SI-Audit.ps1) -->
    <Content Include="..\..\..\config\audit-actions.locked.json" Link="catalog\audit-actions.locked.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- #277: the closed list of guards, the same file the PowerShell guard events read (engine\_shared\SI-Guard.ps1) -->
    <Content Include="..\..\..\config\guard-catalog.locked.json" Link="catalog\guard-catalog.locked.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- #405: fix | default | microsoft per shipped template, the same file the PowerShell publish reads (Get-SIProTemplateClass) -->
    <Content Include="..\..\..\config\template-classification.locked.json" Link="catalog\template-classification.locked.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- the mandatory controls on top of templates, the same file the run applies (engine\pro-settings\SI-TemplateMandatory.ps1) -->
    <Content Include="..\..\..\config\template-mandatory.locked.json" Link="catalog\template-mandatory.locked.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- #404: the configuration set (journal / backup / undo / restore), the same file the schema generator and PowerShell read -->
    <Content Include="..\..\..\config\config-entities.locked.json" Link="catalog\config-entities.locked.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- V3-DATA-MODEL 2.11: the verification service's check catalog, the same file the engine reads (engine\verification\) -->
    <Content Include="..\..\..\config\verification-checks.locked.json" Link="catalog\verification-checks.locked.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- #482 ENV-REPORT-1: what each identity must hold, the same file the engines' permission self-check reads -->
    <Content Include="..\..\..\config\permissions.locked.json" Link="catalog\permissions.locked.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The ServiceNow test pack (fictional sample rows for the customer's ServiceNow team), generated by
       setup\New-SIServiceNowTestPack.ps1 and held to the shipped views by tests\pester\SIv3-SnowTestPack.Tests.ps1.
       Embedded, so the connector page shows it and offers it as a zip without reading the disk. -->
  <ItemGroup>
    <EmbeddedResource Include="Cmdb\ServiceNowTestPack\**\*" LogicalName="ServiceNowTestPack/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- #679: the documentation of THIS version (setup\Import-SIProductDocs.ps1 copies the published pages into ProductDocs\),
       embedded so every install (also one without contact) shows the pages of the version it runs and the
       Documentation page never reads the disk or the network. Not content: nothing of it is copied next to the app. -->
  <ItemGroup>
    <Content Remove="ProductDocs\**" />
    <None Remove="ProductDocs\**" />
    <EmbeddedResource Include="ProductDocs\**\*" LogicalName="ProductDocs/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- #757: the approximate monthly list prices of the sizes Operations > Performance offers (dated, embedded: never read from disk) -->
  <ItemGroup>
    <Content Remove="Performance\size-prices.json" />
    <None Remove="Performance\size-prices.json" />
    <EmbeddedResource Include="Performance\size-prices.json" LogicalName="Performance/size-prices.json" />
  </ItemGroup>

  <!-- The management presentation's logo (Presentation\MgmtDeck.cs): Invardia's Pro horizontal colour logo, the brand pack's
       PNG and SVG unchanged, embedded so a deck never reads the disk. The files stay in wwwroot\brand as well. -->
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\brand\invardia-securityinsight-pro-horizontal-colour-2048w.png" LogicalName="Presentation/logo.png" />
    <EmbeddedResource Include="wwwroot\brand\invardia-securityinsight-pro-horizontal-colour.svg" LogicalName="Presentation/logo.svg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SI.Management.Web.Tests" />
  </ItemGroup>

</Project>
