stage":"production","axis":"probability"},"expiring_credentials":{"name":"Credentials expire within 30 days","impact":1,"stage":"production","axis":"probability"},"has_secret":{"name":"Client secret in use","impact":1,"stage":"production","axis":"probability"},"expired_credentials":{"name":"Expired credentials","impact":1,"stage":"production","axis":"probability"},"identity_high_blast_radius":{"name":"High blast radius (Defender for Identity)","impact":1,"stage":"production","axis":"probability"},"identity_at_risk":{"name":"Identity at risk (Defender for Identity)","impact":1,"stage":"production","axis":"probability"},"break_glass":{"name":"Emergency-access account","impact":1,"stage":"production","axis":"probability"},"leaked_credentials":{"name":"Leaked credentials","impact":1,"stage":"testing","axis":"probability"},"high_risk_port_open":{"name":"Administrative port open to the internet","impact":1,"stage":"production","axis":"probability"},"high_cvss_public_ip":{"name":"CVSS 9 or higher","impact":1,"stage":"production","axis":"probability"},"ms_criticality_high":{"name":"High Microsoft criticality","impact":1,"stage":"production","axis":"consequence"},"production_environment":{"name":"Production environment","impact":1,"stage":"production","axis":"consequence"},"restricted_data":{"name":"Restricted data","impact":1,"stage":"production","axis":"consequence"},"confidential_data":{"name":"Confidential data","impact":1,"stage":"production","axis":"consequence"},"exploit_available":{"name":"Exploit available","impact":1,"stage":"production","axis":"probability"},"remote_code_execution":{"name":"Remote code execution","impact":1,"stage":"production","axis":"consequence"},"report_scoped":{"name":"Factors computed inside one report","impact":1,"stage":"production","axis":"probability"}},
