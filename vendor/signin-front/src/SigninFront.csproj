<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The shared sign-in front (framework DOCS/REQUIREMENTS.md §12.11g). One source, every product builds its image
       from it at the VERSION it pins. Product-neutral: no product name, path or setting lives in this project. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SigninFront</RootNamespace>
    <AssemblyName>SigninFront</AssemblyName>
    <!-- 1.4.1: NOT invariant. Microsoft.Data.SqlClient (the 1.3.0 state store) refuses Globalization Invariant Mode on Linux:
         every request answered 500 on PIM internal (2026-10-21); the Windows test VM could not show it. The aspnet
         image carries ICU. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.4.4</Version>
    <!-- A package with a known vulnerability (direct or transitive) FAILS the build: sign-in code never ships on one. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 3.16.0: >= 3.8.2, which fixes GHSA-rpq8-q44m-2rpg (3.2.0 - 3.8.1). -->
    <PackageReference Include="Microsoft.Identity.Web" Version="3.16.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.1.0" />
    <!-- 1.3.0: the state in the product's SQL (managed identity sign-in) and the Data Protection keys wrapped by Key Vault. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Azure.Identity" Version="1.13.1" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.2.4" />
    <!-- Transitive (Microsoft.Identity.Web) lifted to the patched 8.0.x: Pkcs 8.0.2 (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx),
         Xml 8.0.5 (GHSA-7hqp-7c5m-4vq6, GHSA-c399-9853-6jmj, GHSA-r955-8q5j-3h83, GHSA-vrv5-2jg9-4mmr). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.5" />
  </ItemGroup>

</Project>
