<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The shared sign-in front (framework DOCS/REQUIREMENTS.md §12.11g). One source, every product builds its image
       from it at the VERSION it pins. Product-neutral: no product name, path or setting lives in this project. -->
  <PropertyGroup>
    <!-- 2.0.0 (IMAGE-PATCH-1 point 0): .NET 10 LTS; .NET 8 is out of support on 2026-11-10. -->
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SigninFront</RootNamespace>
    <AssemblyName>SigninFront</AssemblyName>
    <!-- 1.4.1: NOT invariant. Microsoft.Data.SqlClient (the 1.3.0 state store) refuses Globalization Invariant Mode on Linux:
         every request answered 500 on PIM internal (2026-10-21); the Windows test VM could not show it. The aspnet
         image carries ICU. 1.4.6: the runtime is aspnet:8.0-noble-chiseled-EXTRA (2.0.0: 10.0), the chiseled variant that
         carries ICU and tzdata; the plain chiseled image is invariant-only and would bring the 500 back. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>2.1.0</Version>
    <!-- A package with a known vulnerability (direct or transitive) FAILS the build: sign-in code never ships on one. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- 2.0.0: every package at its newest stable version with a net10.0 build and no known advisory (api.nuget.org,
         2026-11-10). Microsoft.Identity.Web 4.x (>= 3.8.2 keeps the GHSA-rpq8-q44m-2rpg fix). -->
    <PackageReference Include="Microsoft.Identity.Web" Version="4.18.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <!-- 1.3.0: the state in the product's SQL (managed identity sign-in) and the Data Protection keys wrapped by Key Vault.
         SqlClient stays on 6.x: 7.x moved Entra authentication (Authentication=Active Directory Managed Identity) into a
         separate extension package: a move of its own, not part of the .NET 10 change. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.8" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Extensions.AspNetCore.DataProtection.Keys" Version="1.6.5" />
    <!-- 2.0.0: no System.Security.Cryptography.Pkcs / .Xml lift any more (1.4.x pinned the patched 8.0.x). See README 2.0.0. -->
  </ItemGroup>

</Project>
